<terrain> => <terrainConfig> <meshConfig> <rivers> <contours>;

# Configuration
<terrainConfig> => SIZE(`512`) | SIZE(`768`) | SIZE(`1024`) | SIZE(`1024`);
<meshConfig> => MESH(<$npts>, <$ncities>, <$nterrs>);
<$npts> => 4096 | 8192 | 16384;
<$ncities> => 10 | 15 | 20 | 25;
<$nterrs> => 4 | 5 | 6 | 7;

# Rivers (used for mesh simulation too)
<rivers> => RIVERS(<$riverCount>);
<$riverCount> => 5 | 8 | 12;

# Contour lines at specified intervals
<contours> => CONTOURS(<$contourInterval>);
<$contourInterval> => 10 | 20;
